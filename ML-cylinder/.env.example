SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SERVER_SIDE_SUPABASE_KEY
SUPABASE_TABLE=smart_cylinder_analysis
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SUPABASE_SERVICE_ROLE_KEY
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=pi5-acoustic-ingestor
MQTT_TOPIC=smartCylinder/+/+/raw
MODEL_DIR=/opt/acoustic/models
MODEL_VERSION=v1
ANALYSIS_WORKERS=2
ANALYSIS_QUEUE_SIZE=256
TOKEN_TIMEOUT_SECONDS=30
TOKEN_CYCLE_INTERVAL_SECONDS=60
# All Pico devices must answer a token once before packets can be stored or analysed.
PICO_STARTUP_CHECK_TIMEOUT_SECONDS=30
PICO_STARTUP_CHECK_RETRY_SECONDS=10
UPLOAD_BATCH_SIZE=100
UPLOAD_INTERVAL_SECONDS=10
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_KEEPALIVE=60
INGEST_DATABASE_PATH=data/raw_ingest.db
DATABASE_PATH=data/smart_cylinder.db
MODEL_PATH=models/cylinder_model.pkl
LOG_PATH=logs/smart_cylinder.log
FFT_USE_HANN_WINDOW=true
UPLOAD_RETRY_SECONDS=30
AUTO_TRAIN_BATCH_SIZE=10
INFERENCE_EXCEL_PATH=data/export/inference_results.xlsx
# Secret used by the Raspberry Pi when it sends the newest annotated camera result
# to https://ml-cylinder.onrender.com/api/camera/frame. Set the same value in Render.
CAMERA_UPLOAD_KEY=
